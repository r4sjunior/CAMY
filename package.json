{
  "name": "vortex-cam",
  "private": true,
  "version": "1.0.0",
  "description": "Vórtice fractal psicodélico em tempo real com a câmera do dispositivo (React + TypeScript + Vite + Three.js).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
